<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.0.4</Version>
    <RepositoryUrl>https://github.com/kinetq/liquid-simple-server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Kinetq</Authors>
    <Description>A .NET CLI tool for scaffolding files from templates (LiquidPages, etc.)</Description>
    <!-- Package metadata -->
    <PackageTags>liquid;templates;scaffolding;code-generation;liquid-pages</PackageTags>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <IsShippingPackage>true</IsShippingPackage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Templates\**" PackagePath="Templates" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Templates\**\*.cs" />
  </ItemGroup>

</Project>
