{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kinetq",
  "classifications": [ "Web", "LiquidPages" ],
  "identity": "Kinetq.LiquidPages.ErrorPage",
  "name": "Liquid Page",
  "description": "Creates a new Liquid Error Page with code-behind (Razor Pages style)",
  "shortName": "liquiderrorpage",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "NewPage",
  "preferNameDirectory": false,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [ "**/[Bb]in/**", "**/[Oo]bj/**", ".template.config/**/*", "**/*.filelist", "**/*.user", "**/*.lock.json", "Layouts/**" ],
      "rename": {
        "PageModel.cs": "NewPage.liquid.cs",
        "PageTemplate.liquid": "NewPage.liquid"
      }
    }
  ],
  "symbols": {
    "Namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "NAMESPACE_PLACEHOLDER",
      "defaultValue": "MyApp"
    },
    "StatusCode": {
      "type": "parameter",
      "displayName": "Status Code",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        { "choice": "400", "description": "Bad Request" },
        { "choice": "401", "description": "Unauthorized" },
        { "choice": "402", "description": "Payment Required" },
        { "choice": "403", "description": "Forbidden" },
        { "choice": "404", "description": "Not Found" },
        { "choice": "405", "description": "Method Not Allowed" },
        { "choice": "406", "description": "Not Acceptable" },
        { "choice": "407", "description": "Proxy Authentication Required" },
        { "choice": "408", "description": "Request Timeout" },
        { "choice": "409", "description": "Conflict" },
        { "choice": "410", "description": "Gone" },
        { "choice": "411", "description": "Length Required" },
        { "choice": "412", "description": "Precondition Failed" },
        { "choice": "413", "description": "Payload Too Large" },
        { "choice": "414", "description": "URI Too Long" },
        { "choice": "415", "description": "Unsupported Media Type" },
        { "choice": "416", "description": "Range Not Satisfiable" },
        { "choice": "417", "description": "Expectation Failed" },
        { "choice": "421", "description": "Misdirected Request" },
        { "choice": "422", "description": "Unprocessable Entity" },
        { "choice": "423", "description": "Locked" },
        { "choice": "424", "description": "Failed Dependency" },
        { "choice": "425", "description": "Too Early" },
        { "choice": "426", "description": "Upgrade Required" },
        { "choice": "428", "description": "Precondition Required" },
        { "choice": "429", "description": "Too Many Requests" },
        { "choice": "431", "description": "Request Header Fields Too Large" },
        { "choice": "451", "description": "Unavailable For Legal Reasons" },
        { "choice": "500", "description": "Internal Server Error" },
        { "choice": "501", "description": "Not Implemented" },
        { "choice": "502", "description": "Bad Gateway" },
        { "choice": "503", "description": "Service Unavailable" },
        { "choice": "504", "description": "Gateway Timeout" },
        { "choice": "505", "description": "HTTP Version Not Supported" },
        { "choice": "506", "description": "Variant Also Negotiates" },
        { "choice": "507", "description": "Insufficient Storage" },
        { "choice": "508", "description": "Loop Detected" },
        { "choice": "510", "description": "Not Extended" },
        { "choice": "511", "description": "Network Authentication Required" }
      ]
    },
    "HttpStatusCode": {
      "type": "generated",
      "generator": "switch",
      "replaces": "{{HttpStatusCode}}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(StatusCode == '400')", "value": "HttpStatusCode.BadRequest" },
          { "condition": "(StatusCode == '401')", "value": "HttpStatusCode.Unauthorized" },
          { "condition": "(StatusCode == '402')", "value": "HttpStatusCode.PaymentRequired" },
          { "condition": "(StatusCode == '403')", "value": "HttpStatusCode.Forbidden" },
          { "condition": "(StatusCode == '404')", "value": "HttpStatusCode.NotFound" },
          { "condition": "(StatusCode == '405')", "value": "HttpStatusCode.MethodNotAllowed" },
          { "condition": "(StatusCode == '406')", "value": "HttpStatusCode.NotAcceptable" },
          { "condition": "(StatusCode == '407')", "value": "HttpStatusCode.ProxyAuthenticationRequired" },
          { "condition": "(StatusCode == '408')", "value": "HttpStatusCode.RequestTimeout" },
          { "condition": "(StatusCode == '409')", "value": "HttpStatusCode.Conflict" },
          { "condition": "(StatusCode == '410')", "value": "HttpStatusCode.Gone" },
          { "condition": "(StatusCode == '411')", "value": "HttpStatusCode.LengthRequired" },
          { "condition": "(StatusCode == '412')", "value": "HttpStatusCode.PreconditionFailed" },
          { "condition": "(StatusCode == '413')", "value": "HttpStatusCode.RequestEntityTooLarge" },
          { "condition": "(StatusCode == '414')", "value": "HttpStatusCode.RequestUriTooLong" },
          { "condition": "(StatusCode == '415')", "value": "HttpStatusCode.UnsupportedMediaType" },
          { "condition": "(StatusCode == '416')", "value": "HttpStatusCode.RequestedRangeNotSatisfiable" },
          { "condition": "(StatusCode == '417')", "value": "HttpStatusCode.ExpectationFailed" },
          { "condition": "(StatusCode == '421')", "value": "HttpStatusCode.MisdirectedRequest" },
          { "condition": "(StatusCode == '422')", "value": "HttpStatusCode.UnprocessableEntity" },
          { "condition": "(StatusCode == '423')", "value": "HttpStatusCode.Locked" },
          { "condition": "(StatusCode == '424')", "value": "HttpStatusCode.FailedDependency" },
          { "condition": "(StatusCode == '425')", "value": "HttpStatusCode.TooEarly" },
          { "condition": "(StatusCode == '426')", "value": "HttpStatusCode.UpgradeRequired" },
          { "condition": "(StatusCode == '428')", "value": "HttpStatusCode.PreconditionRequired" },
          { "condition": "(StatusCode == '429')", "value": "HttpStatusCode.TooManyRequests" },
          { "condition": "(StatusCode == '431')", "value": "HttpStatusCode.RequestHeaderFieldsTooLarge" },
          { "condition": "(StatusCode == '451')", "value": "HttpStatusCode.UnavailableForLegalReasons" },
          { "condition": "(StatusCode == '500')", "value": "HttpStatusCode.InternalServerError" },
          { "condition": "(StatusCode == '501')", "value": "HttpStatusCode.NotImplemented" },
          { "condition": "(StatusCode == '502')", "value": "HttpStatusCode.BadGateway" },
          { "condition": "(StatusCode == '503')", "value": "HttpStatusCode.ServiceUnavailable" },
          { "condition": "(StatusCode == '504')", "value": "HttpStatusCode.GatewayTimeout" },
          { "condition": "(StatusCode == '505')", "value": "HttpStatusCode.HttpVersionNotSupported" },
          { "condition": "(StatusCode == '506')", "value": "HttpStatusCode.VariantAlsoNegotiates" },
          { "condition": "(StatusCode == '507')", "value": "HttpStatusCode.InsufficientStorage" },
          { "condition": "(StatusCode == '508')", "value": "HttpStatusCode.LoopDetected" },
          { "condition": "(StatusCode == '510')", "value": "HttpStatusCode.NotExtended" },
          { "condition": "(StatusCode == '511')", "value": "HttpStatusCode.NetworkAuthenticationRequired" }
        ]
      }
    },
    "Name": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "defaultValue": "NewPage",
      "replaces": "{{Name}}"
    }
  },
  "forms": {
   
  },
  "constraints": {
    "csharp-only": {
      "type": "project-capability",
      "args": "CSharp"
    }
  }
}
