# EditorConfig for Liquid template files
# This file is automatically created when you add your first Liquid page

root = true

# Liquid template files
[*.liquid]
indent_size = 4
indent_style = space

# Disable HTML validation for Liquid files to allow partials without root elements
dotnet_diagnostic.HTML001.severity = none  # Text is not allowed at root level
dotnet_diagnostic.HTML002.severity = none  # Multiple root elements
