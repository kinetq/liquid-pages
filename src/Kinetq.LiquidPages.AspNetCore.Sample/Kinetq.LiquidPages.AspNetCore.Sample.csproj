<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
	<Content Include="**\*.liquid" Exclude="bin\**;obj\**">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	</Content>

	<ProjectReference Include="..\Kinetq.LiquidPages.AspNetCore\Kinetq.LiquidPages.AspNetCore.csproj" />
	<ProjectReference Include="..\Kinetq.LiquidPages\Kinetq.LiquidPages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.liquid" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Components\BenchmarkTable.liquid" />
    <Content Remove="Components\Hero.liquid" />
    <Content Remove="Components\SummaryCards.liquid" />
    <Content Remove="Layouts\default.liquid" />
  </ItemGroup>

</Project>
