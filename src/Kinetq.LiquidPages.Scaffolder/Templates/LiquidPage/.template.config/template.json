{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kinetq",
  "classifications": [ "Web", "LiquidPages" ],
  "identity": "Kinetq.LiquidPages.Page",
  "name": "Liquid Page",
  "description": "Creates a new Liquid Page with code-behind (Razor Pages style)",
  "shortName": "liquidpage",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "NewPage",
  "preferNameDirectory": false,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [ "**/[Bb]in/**", "**/[Oo]bj/**", ".template.config/**/*", "**/*.filelist", "**/*.user", "**/*.lock.json", "Layouts/**" ],
      "rename": {
        "PageModel.cs": "NewPage.liquid.cs",
        "PageTemplate.liquid": "NewPage.liquid"
      }
    },
    {
      "source": "./Layouts",
      "target": "./Layouts",
      "condition": "(GenerateLayout)",
      "include": [ "**/*" ],
      "copyOnly": [ "**/*" ]
    }
  ],
  "symbols": {
    "Namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "NAMESPACE_PLACEHOLDER",
      "defaultValue": "MyApp"
    },
    "RoutePath": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowercase",
      "replaces": "{{RoutePath}}"
    },
    "TemplatePath": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "snakecaseWithExtension",
      "replaces": "{{TemplatePath}}"
    },
    "GenerateLayout": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate a default layout file if it doesn't already exist"
    }
  },
  "forms": {
    "lowercase": {
      "identifier": "lowercase"
    },
    "snakecaseWithExtension": {
      "identifier": "chain",
      "steps": [
        "snakecase",
        "addLiquidExtension"
      ]
    },
    "snakecase": {
      "identifier": "replace",
      "pattern": "([a-z0-9])([A-Z])",
      "replacement": "$1_$2"
    },
    "addLiquidExtension": {
      "identifier": "chain",
      "steps": [
        "lowercase",
        "appendExtension"
      ]
    },
    "appendExtension": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1.liquid"
    }
  },
  "constraints": {
    "csharp-only": {
      "type": "project-capability",
      "args": "CSharp"
    }
  }
}
