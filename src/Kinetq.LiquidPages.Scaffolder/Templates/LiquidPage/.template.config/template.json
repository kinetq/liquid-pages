{
  "name": "LiquidPage",
  "description": "Creates a new Liquid Page with code-behind (Razor Pages style)",
  "author": "Kinetq",
  "version": "1.0.0",
  "defaultName": "NewPage",
  "files": [
    {
      "source": "PageModel.cs",
      "target": "{{FileName}}.liquid.cs",
      "replaceParameters": true
    },
    {
      "source": "PageTemplate.liquid",
      "target": "{{FileName}}.liquid",
      "replaceParameters": true
    }
  ],
  "parameters": {
    "FileName": {
      "description": "The name of the file/page",
      "required": true
    },
    "Namespace": {
      "description": "The namespace for the generated code",
      "required": true
    },
    "OutputPath": {
      "description": "The relative output path from project root",
      "required": false,
      "default": ""
    }
  }
}
