{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kinetq",
  "classifications": [ "Web", "LiquidPages" ],
  "identity": "Kinetq.LiquidPages.Page",
  "name": "Liquid Page",
  "description": "Creates a new Liquid Page with code-behind (Razor Pages style)",
  "shortName": "liquidpage",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "NewPage",
  "preferNameDirectory": false,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [ "**/[Bb]in/**", "**/[Oo]bj/**", ".template.config/**/*", "**/*.filelist", "**/*.user", "**/*.lock.json", "Layouts/**" ],
      "rename": {
        "PageModel.cs": "NewPage.liquid.cs",
        "PageTemplate.liquid": "NewPage.liquid"
      }
    },
    {
      "source": "./Layouts",
      "target": "./Layouts",
      "condition": "(GenerateLayout)",
      "include": [ "**/*" ],
      "copyOnly": [ "**/*" ]
    }
  ],
  "symbols": {
    "Namespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "replaces": "NAMESPACE_PLACEHOLDER",
      "defaultValue": "MyApp"
    },
    "RoutePath": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebabcase",
      "replaces": "{{RoutePath}}"
    },
    "Name": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "defaultValue": "NewPage",
      "replaces": "{{Name}}"
    },
    "GenerateLayout": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate a default layout file if it doesn't already exist"
    },
    "SkipEmbeddedResourceConfig": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip automatic configuration of EmbeddedResource for .liquid files"
    }
  },
  "forms": {
    "lowercase": {
      "identifier": "lowercase"
    },
    "kebabcase": {
      "identifier": "chain",
      "steps": [
        "kebabcaseTransform",
        "lowercase"
      ]
    },
    "kebabcaseTransform": {
      "identifier": "replace",
      "pattern": "([a-z0-9])([A-Z])",
      "replacement": "$1-$2"
    },
    "snakecaseWithExtension": {
      "identifier": "chain",
      "steps": [
        "snakecase",
        "addLiquidExtension"
      ]
    },
    "snakecase": {
      "identifier": "replace",
      "pattern": "([a-z0-9])([A-Z])",
      "replacement": "$1_$2"
    },
    "addLiquidExtension": {
      "identifier": "chain",
      "steps": [
        "lowercase",
        "appendExtension"
      ]
    },
    "appendExtension": {
      "identifier": "replace",
      "pattern": "^(.*)$",
      "replacement": "$1.liquid"
    }
  },
  "constraints": {
    "csharp-only": {
      "type": "project-capability",
      "args": "CSharp"
    }
  },
  "postActions": [
    {
      "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
      "condition": "(!SkipEmbeddedResourceConfig)",
      "description": "Add EmbeddedResource ItemGroup for .liquid files",
      "manualInstructions": [
        {
          "text": "For production builds, you'll need to enable .liquid file embedding, add this to your .csproj file:\n\n<ItemGroup>\n  <EmbeddedResource Include=\"**\\*.liquid\" />\n</ItemGroup>"
        }
      ],
      "args": {
        "files": [ "0" ],
        "xmlContents": "<ItemGroup><EmbeddedResource Include=\"**\\*.liquid\" /></ItemGroup>"
      },
      "continueOnError": true
    }
  ]
}
