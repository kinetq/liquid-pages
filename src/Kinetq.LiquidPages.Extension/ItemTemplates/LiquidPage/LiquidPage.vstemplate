<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Liquid Page</Name>
    <Description>Creates a new Liquid Page with code-behind (Razor Pages style)</Description>
    <Icon>LiquidPageIcon.png</Icon>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>100</SortOrder>
    <DefaultName>NewPage</DefaultName>
  </TemplateData>
  <TemplateContent>
    <References />
    <ProjectItem SubType="Code" TargetFileName="$fileinputname$.liquid.cs" ReplaceParameters="true">LiquidPageCodeBehind.cs</ProjectItem>
    <ProjectItem SubType="" TargetFileName="$fileinputname$.liquid" ReplaceParameters="true">LiquidPageTemplate.liquid</ProjectItem>
    <CustomParameters>
      <CustomParameter Name="$modelclassname$" Value="$fileinputname$Model"/>
    </CustomParameters>
  </TemplateContent>
</VSTemplate>
