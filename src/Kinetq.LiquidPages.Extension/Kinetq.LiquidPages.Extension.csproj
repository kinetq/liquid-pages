<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Don't auto-include .cs files from ItemTemplates -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

  <!-- Exclude ItemTemplates from compilation -->

  <!-- Include ItemTemplates as content to copy to output -->
  <ItemGroup>
    <None Remove="Overview.md" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Overview.md" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Dialogs\AddLiquidErrorPageDialogControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="Dialogs\AddLiquidPageDialogControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Logo images: Resource for runtime/imagemanifest, Content for VSIX packaging -->
  <ItemGroup>
    <Resource Include="Images\Logo.png" />
    <Resource Include="Images\Logo32x32.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\Logo.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\Logo32x32.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Include the Liquid formatter executable -->
    <Content Include="Static\formatter.exe">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>formatter.exe</Link>
    </Content>
  </ItemGroup>

  <!-- Static Content items for language server files staged into LanguageServer\ subfolder.
       These are evaluated before Build so the VSIX packager includes them. -->
  <ItemGroup>
    <Content Include="LanguageServer\**\*.*" Exclude="LanguageServer\.gitkeep">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Build the Language Server before building the extension -->
  <Target Name="BuildLanguageServer" BeforeTargets="BeforeBuild">
    <Message Text="Publishing Liquid Language Server (self-contained, win-x64)..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\Kinetq.LiquidPages.LanguageServer\Kinetq.LiquidPages.LanguageServer.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(MSBuildProjectDirectory)\..\Kinetq.LiquidPages.LanguageServer\bin\$(Configuration)\net9.0\publish\&quot;" />
    <Message Text="Liquid Language Server published successfully" Importance="high" />
  </Target>

  <!-- Copy Language Server files into the project's LanguageServer subfolder BEFORE Build so VSIX packaging picks them up -->
  <Target Name="CopyLanguageServerFiles" AfterTargets="BuildLanguageServer" BeforeTargets="Build">
    <PropertyGroup>
      <LanguageServerSourceDir>$(MSBuildProjectDirectory)\..\Kinetq.LiquidPages.LanguageServer\bin\$(Configuration)\net9.0\publish</LanguageServerSourceDir>
      <LanguageServerStagingDir>$(MSBuildProjectDirectory)\LanguageServer</LanguageServerStagingDir>
    </PropertyGroup>

    <ItemGroup>
      <LanguageServerFiles Include="$(LanguageServerSourceDir)\**\*.*" />
    </ItemGroup>

    <Message Text="Copying Language Server files from $(LanguageServerSourceDir) to $(LanguageServerStagingDir)..." Importance="high" />
    <Copy SourceFiles="@(LanguageServerFiles)" DestinationFolder="$(LanguageServerStagingDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Build the formatter executable before building the extension -->
  <Target Name="BuildFormatter" BeforeTargets="BeforeBuild">
    <Message Text="Building Liquid formatter..." Importance="high" />
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)\Static" Condition="!Exists('$(MSBuildProjectDirectory)\Static\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Static" />
    <Message Text="Liquid formatter built successfully" Importance="high" />
  </Target>
</Project>
