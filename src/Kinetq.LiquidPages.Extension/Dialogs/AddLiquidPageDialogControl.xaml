<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">
    <StackPanel Orientation="Vertical" Margin="10" MinWidth="350">
        <TextBlock Text="Enter the name for the new Liquid Page:" 
                   Margin="0,0,0,5"
                   TextWrapping="Wrap"
                   FontSize="14"
                   FontWeight="SemiBold"/>
        <TextBlock Text="The name will be converted to PascalCase (e.g., 'contact us' → 'ContactUs')" 
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="Gray"/>
        <TextBox x:Name="PageNameTextBox"
                 Text="{Binding PageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 MinWidth="300"
                 Margin="0,0,0,15"
                 Padding="5"
                 FontSize="13"/>

        <CheckBox x:Name="ForceCheckBox"
                  Content="Force overwrite if file exists"
                  IsChecked="{Binding Force, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,15"/>

        <CheckBox x:Name="GenerateLayoutCheckBox"
                  Content="Generate a Layout file along with the page"
                  IsChecked="{Binding GenerateLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,15"/>

    </StackPanel>
</DataTemplate>