<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:webview="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
		x:Class="Kinetq.LiquidPages.Avalonia.Sample.MainWindow"
		Width="1000"
		Height="700"
		Title="LiquidPages Avalonia RouteTree Sample">
	<Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="10">
	<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
		<TextBox x:Name="AddressTextBox" PlaceholderText="Enter route (for example /)" />
	  <Button Grid.Column="1"
			  x:Name="NavigateButton"
			  Content="Navigate"
			  MinWidth="96" />
	</Grid>

	<webview:NativeWebView Grid.Row="1" x:Name="Browser" />

	<TextBox Grid.Row="2"
			 x:Name="HtmlPreviewTextBox"
			 AcceptsReturn="True"
			 IsReadOnly="True"
			  TextWrapping="Wrap" />
  </Grid>
</Window>
