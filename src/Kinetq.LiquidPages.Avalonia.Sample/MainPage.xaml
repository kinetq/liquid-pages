<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kinetq.LiquidPages.Avalonia.Sample.MainPage"
             Title="LiquidPages MAUI HybridWebView Sample">

    <Grid Padding="12"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <Entry x:Name="AddressEntry"
                   Placeholder="Enter route (for example /)"
                   ReturnType="Go" />

            <Button Grid.Column="1"
                    x:Name="NavigateButton"
                    Text="Navigate"
                    WidthRequest="110"
                    Clicked="NavigateButtonOnClicked" />
        </Grid>

        <ContentView Grid.Row="1"
                     x:Name="BrowserHost" />

        <Editor Grid.Row="2"
                x:Name="HtmlPreviewEditor"
                IsReadOnly="True"
                AutoSize="TextChanges"
                Placeholder="Response status appears here" />
    </Grid>

</ContentPage>
