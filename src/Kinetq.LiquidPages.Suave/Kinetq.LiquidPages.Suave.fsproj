<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LiquidPagesSuaveMiddleware.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Suave" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinetq.LiquidPages\Kinetq.LiquidPages.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Version>0.0.1</Version>
    <RepositoryUrl>https://github.com/kinetq/liquid-pages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>This is a library provides liquid pages middleware for Suave.</Description>
    <Authors>Sammi Sinno</Authors>
  </PropertyGroup>

</Project>
